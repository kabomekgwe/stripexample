# Build stage
FROM node:22 AS builder
RUN corepack enable && corepack prepare pnpm@10.24.0 --activate
ENV CI=true
WORKDIR /app
COPY . .
# Force pnpm to allow all build scripts (v10 security override)
RUN pnpm config set only-built-dependencies-all true
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @payments/shared build
RUN pnpm --filter backend build

# Runner stage
FROM node:22 AS runner
WORKDIR /app
ENV NODE_ENV=production

# Copy EVERYTHING from builder
COPY --from=builder /app /app

EXPOSE 3000
CMD ["sh", "-c", "node backend/dist/src/db/migrate.js && node backend/dist/src/main.js"]
